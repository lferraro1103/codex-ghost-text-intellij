<idea-plugin>
  <id>com.leandro.codexghosttext</id>
  <name>Codex Ghost Text</name>
  <vendor email="leandro@localhost">Leandro</vendor>
  <description>Generate a guarded Codex proposal from a selected comment.</description>

  <depends>com.intellij.modules.platform</depends>
  <!-- PSI, references and the structure view, used to name the project files a proposal depends on. -->
  <depends>com.intellij.modules.lang</depends>

  <extensions defaultExtensionNs="com.intellij">
    <notificationGroup id="Codex Ghost Text" displayType="BALLOON" isLogByDefault="false" />
    <applicationService serviceImplementation="com.leandro.codexghosttext.editor.GhostKeyHandlerInstaller" />
    <typedHandler implementation="com.leandro.codexghosttext.editor.CodexGhostTypedHandler" />
    <statusBarWidgetFactory id="CodexGhostText.ProviderSelector"
                            implementation="com.leandro.codexghosttext.status.ProviderSelectorWidgetFactory" />
  </extensions>

  <actions>
    <action id="com.leandro.codexghosttext.CheckCodexConnection"
            class="com.leandro.codexghosttext.actions.CheckCodexConnectionAction"
            text="Check Selected AI Provider Connection"
            description="Check the selected local AI provider without generating code">
      <add-to-group group-id="ToolsMenu" anchor="last" />
    </action>
    <action id="com.leandro.codexghosttext.ResetCodexProjectConversation"
            class="com.leandro.codexghosttext.actions.ResetCodexProjectConversationAction"
            text="Reset Selected Provider Conversation for This Project"
            description="Forget this project's selected provider conversation and create a new one on the next generation">
      <add-to-group group-id="ToolsMenu" anchor="last" />
    </action>
    <action id="com.leandro.codexghosttext.GenerateCodexGhostText"
            class="com.leandro.codexghosttext.actions.GenerateCodexGhostTextAction"
            text="Generate AI Ghost Text"
            description="Generate an AI code proposal from the selected comment">
      <add-to-group group-id="EditorPopupMenu" anchor="last" />
    </action>
  </actions>
</idea-plugin>
